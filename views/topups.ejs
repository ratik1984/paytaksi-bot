<%- include('layout_header') %>

<div class="card p-3">
  <h5 class="mb-3">Balans artırma qəbzləri</h5>
  <div class="table-responsive">
    <table class="table table-dark table-striped align-middle">
      <thead>
        <tr>
          <th>ID</th>
          <th>Sürücü</th>
          <th>Məbləğ</th>
          <th>Üsul</th>
          <th>Status</th>
          <th>Qəbz file_id</th>
          <th>Əməliyyat</th>
        </tr>
      </thead>
      <tbody>
        <% topups.forEach(t => { %>
          <tr>
            <td>#<%= t.id %></td>
            <td><%= (t.first_name||'') %> <%= (t.last_name||'') %> / <%= t.phone || '' %></td>
            <td><%= money2(t.amount_azn) %> ₼</td>
            <td><%= t.method %></td>
            <td><span class="badge bg-<%= t.status==='approved'?'success':(t.status==='pending'?'warning':'danger') %>"><%= t.status %></span></td>
            <td><code><%= t.receipt_file_id || '' %></code></td>
            <td style="min-width:360px">
              <% if (t.status==='pending') { %>
                <div class="d-flex flex-column gap-2">
                  <form class="d-flex gap-2" method="post" action="/admin/topups/<%= t.id %>/approve">
                    <input class="form-control form-control-sm" name="amount_azn" value="<%= money2(t.amount_azn) %>" required />
                    <input class="form-control form-control-sm" name="note" placeholder="Qeyd" />
                    <button class="btn btn-sm btn-success">Təsdiq</button>
                  </form>
                  <form class="d-flex gap-2" method="post" action="/admin/topups/<%= t.id %>/reject">
                    <input class="form-control form-control-sm" name="note" placeholder="Rədd səbəbi" />
                    <button class="btn btn-sm btn-danger">Rədd et</button>
                  </form>
                </div>
              <% } else { %>
                <div class="muted">Qeyd: <%= t.admin_note || '-' %></div>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="muted small">Qəbz şəkli Telegram file_id kimi saxlanır. İstəsəniz sonradan bot vasitəsilə download link çıxarmaq funksiyası əlavə edə bilərik.</div>
</div>

<%- include('layout_footer') %>

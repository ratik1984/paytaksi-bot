<%- include('layout_header') %>

<div class="card p-3 mb-3">
  <h5>Ledger: <%= (driver.first_name||'') %> <%= (driver.last_name||'') %> (#<%= driver.id %>)</h5>
  <div class="muted">Balans: <b><%= money2(driver.balance) %> ₼</b> | Status: <%= driver.status %></div>
</div>

<div class="card p-3">
  <div class="table-responsive">
    <table class="table table-dark table-striped align-middle">
      <thead>
        <tr>
          <th>Tarix</th>
          <th>Növ</th>
          <th>Məbləğ</th>
          <th>Ref</th>
          <th>Qeyd</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(r => { %>
          <tr>
            <td class="muted"><%= r.created_at ? new Date(r.created_at).toLocaleString('az-AZ') : '' %></td>
            <td><%= r.kind %></td>
            <td><%= money2(r.amount_azn) %> ₼</td>
            <td class="muted"><%= r.ref_table || '' %> #<%= r.ref_id || '' %></td>
            <td><%= r.note || '' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('layout_footer') %>

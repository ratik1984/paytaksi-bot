<%- include('layout_header') %>

<div class="row g-3">
  <div class="col-md-4"><div class="card p-3"><div class="muted">Sürücülər</div><div class="display-6"><%= stats.drivers %></div></div></div>
  <div class="col-md-4"><div class="card p-3"><div class="muted">Aktiv sürücü</div><div class="display-6"><%= stats.activeDrivers %></div></div></div>
  <div class="col-md-4"><div class="card p-3"><div class="muted">Pending sürücü</div><div class="display-6"><%= stats.pendingDrivers %></div></div></div>
  <div class="col-md-6"><div class="card p-3"><div class="muted">Gözləyən qəbz</div><div class="display-6"><%= stats.pendingTopups %></div></div></div>
  <div class="col-md-6"><div class="card p-3"><div class="muted">Gedişlər (cəmi)</div><div class="display-6"><%= stats.rides %></div></div></div>
</div>

<div class="mt-4 card p-3">
  <h5>Linklər</h5>
  <div class="d-flex gap-2 flex-wrap">
    <a class="btn btn-outline-light" href="/admin/drivers">Sürücülər</a>
    <a class="btn btn-outline-light" href="/admin/topups">Qəbzlər</a>
    <a class="btn btn-outline-light" href="/admin/rides">Gedişlər</a>
  </div>
</div>

<%- include('layout_footer') %>

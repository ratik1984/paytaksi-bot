<!doctype html>
<html lang="az">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>PayTaksi Admin Login</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body{background:#0b1220;color:#e6e9ef;display:flex;align-items:center;justify-content:center;min-height:100vh}
    .card{background:#111a2e;border:1px solid #1f2b45;width:420px}
  </style>
</head>
<body>
  <div class="card p-4">
    <h4 class="mb-3">PayTaksi Admin</h4>
    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>
    <form method="post" action="/admin/login">
      <div class="mb-3">
        <label class="form-label">Login</label>
        <input class="form-control" name="username" required />
      </div>
      <div class="mb-3">
        <label class="form-label">Şifrə</label>
        <input class="form-control" name="password" type="password" required />
      </div>
      <button class="btn btn-primary w-100">Daxil ol</button>
    </form>
    <div class="mt-3 small text-secondary">Render/GitHub deploy: README.md</div>
  </div>
</body>
</html>

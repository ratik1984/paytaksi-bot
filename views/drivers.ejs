<%- include('layout_header') %>

<div class="card p-3">
  <h5 class="mb-3">Sürücülər</h5>
  <div class="table-responsive">
    <table class="table table-dark table-striped align-middle">
      <thead>
        <tr>
          <th>ID</th>
          <th>Ad</th>
          <th>Telefon</th>
          <th>Avto</th>
          <th>Status</th>
          <th>Online</th>
          <th>Balans</th>
          <th>Əməliyyat</th>
        </tr>
      </thead>
      <tbody>
        <% drivers.forEach(d => { %>
          <tr>
            <td>#<%= d.id %></td>
            <td><%= (d.first_name||'') %> <%= (d.last_name||'') %></td>
            <td><%= d.phone || '' %></td>
            <td><%= (d.car_brand||'') %> <%= (d.car_model||'') %> (<%= d.car_plate||'' %>)</td>
            <td><span class="badge bg-<%= d.status==='active'?'success':(d.status==='pending'?'warning':'danger') %>"><%= d.status %></span></td>
            <td><%= d.online ? '✅' : '⛔' %> <%= d.busy ? '(busy)' : '' %></td>
            <td><%= money2(d.balance) %> ₼</td>
            <td style="min-width:320px">
              <div class="d-flex gap-2 flex-wrap">
                <form method="post" action="/admin/drivers/<%= d.id %>/activate">
                  <button class="btn btn-sm btn-success" <%= d.status==='active'?'disabled':'' %>>Aktiv et</button>
                </form>
                <form method="post" action="/admin/drivers/<%= d.id %>/block">
                  <button class="btn btn-sm btn-danger">Blokla</button>
                </form>
                <a class="btn btn-sm btn-outline-light" href="/admin/ledger/<%= d.id %>">Ledger</a>
              </div>
              <div class="mt-2">
                <form class="d-flex gap-2" method="post" action="/admin/drivers/<%= d.id %>/balance">
                  <input class="form-control form-control-sm" name="amount_azn" placeholder="+10 və ya -5" required />
                  <input class="form-control form-control-sm" name="note" placeholder="Qeyd" />
                  <button class="btn btn-sm btn-primary">Balans düzəlt</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('layout_footer') %>
